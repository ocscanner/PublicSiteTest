# OC Scanner — Cloudflare Pages headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Pages, the news list and the sitemap: always check for a fresh copy
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/posts/*
  Cache-Control: public, max-age=60, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600

# Scripts and styles change with ?v= in the page, so they can cache for a day
/*.css
  Cache-Control: public, max-age=86400
/*.js
  Cache-Control: public, max-age=3600
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Images and map shapes
/*.png
  Cache-Control: public, max-age=604800
/elections/data/*
  Cache-Control: public, max-age=86400
